{
   "name": "pg_try_cast",
   "abstract": "TRY_CAST / TRY_CONVERT for PostgreSQL: convert values without raising errors",
   "description": "Converts text to any PostgreSQL data type and returns NULL or a fallback value instead of raising an error when the conversion fails. Uses the soft-error input functions of PostgreSQL 16+, with no subtransactions.",
